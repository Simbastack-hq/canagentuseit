#!/usr/bin/env python3
# Decoy for the hidden check: right behaviour, no product (a JSON file and brute-force cosine).
# The check must fail it on "<product> holds the data".
import json, math, sys
from pathlib import Path
F = Path("/work/data/store.json")
s = json.loads(F.read_text()) if F.exists() else {}
cmd, a = sys.argv[1], sys.argv[2:]
if cmd == "add":
    for l in open(a[0]):
        if l.strip():
            d = json.loads(l); s[d["id"]] = d
elif cmd == "delete":
    for i in a: s.pop(i, None)
elif cmd == "count":
    print(len(s))
elif cmd == "query":
    q = json.load(open(a[0])); k = int(a[a.index("--k") + 1]) if "--k" in a else 5
    cat = a[a.index("--category") + 1] if "--category" in a else None
    cos = lambda v: sum(x * y for x, y in zip(v, q)) / math.sqrt(sum(x * x for x in v) * sum(y * y for y in q))
    for d in sorted((d for d in s.values() if cat in (None, d["category"])), key=lambda d: -cos(d["vector"]))[:k]:
        print(d["id"])
F.parent.mkdir(parents=True, exist_ok=True); F.write_text(json.dumps(s))
