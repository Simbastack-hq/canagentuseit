#!/usr/bin/env bash
# caui-box: the only door into a test container. The agent's brain runs outside (on the host, with
# its own login); every command it runs goes through here into a throwaway container that holds no
# credentials at all.
#
#   caui-box start   <run>              fresh container from the pinned image, empty /work
#   caui-box exec    <run> <timeout_s> <command>   bash -lc <command> as `dev` in /work; stdout+stderr, exit code
#   caui-box put     <run> <path>       stdin -> file in the container (path under /work or /tmp)
#   caui-box get     <run> <path>       file in the container -> stdout (2 MB cap)
#   caui-box tarwork <run>              /work as a tar.gz on stdout (no node_modules/.venv/.git, 20 MB cap)
#   caui-box rm      <run>
#   caui-box docswalk <run>             stdin: URLs, one per line -> docs-walk .webm on stdout (B-roll recorder)
#   caui-box build                      rebuild both images from the harness dir, tag with today's date
#   caui-box reap                       remove caui containers older than 2 hours
#
# On the lab it's root-owned in /usr/local/bin and `claude` may run it only as `caui-tester` (sudoers),
# so the brain can't pass its own flags to podman. Anyone else can run it as themselves to reproduce
# a test: CAUI_ENGINE=docker ./sandbox/caui-box start my-run
set -euo pipefail
die() { echo "caui-box: $*" >&2; exit 2; }
ENGINE="${CAUI_ENGINE:-podman}"
# Under sudo, trust the account database for HOME, not the caller.
HOME="$(getent passwd "$(id -un)" | cut -d: -f6)"; export HOME
CONF="${CAUI_CONF:-$HOME/.config/caui}"
HARNESS="${CAUI_HARNESS:-/srv/caui/harness}"
IMAGE="$(cat "$CONF/image" 2>/dev/null || echo caui-sandbox:latest)"
RECORDER="$(cat "$CONF/recorder" 2>/dev/null || echo caui-recorder:latest)"
if [ "$ENGINE" = podman ]; then
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  NET="pasta:--no-map-gw"
else
  NET="${CAUI_DOCKER_NET:-bridge}"
fi
SAFE=(--cap-drop ALL --security-opt no-new-privileges --pids-limit 1024)

verb="${1:-}"; shift || true
if [[ "$verb" != build && "$verb" != reap ]]; then
  run="${1:-}"; shift || true
  [[ "$run" =~ ^[a-z0-9][a-z0-9-]{2,90}$ ]] || die "bad run id"
  c="caui-$run"
fi
path_ok() { [[ "$1" =~ ^/(work|tmp)(/[A-Za-z0-9._@+=,-]+)*/?$ && "$1" != *..* ]] || die "path must be under /work or /tmp"; }

case "$verb" in
  start)
    "$ENGINE" rm -f "$c" >/dev/null 2>&1 || true
    "$ENGINE" run -d --name "$c" --hostname sandbox --network "$NET" --memory 4g --cpus 2 "${SAFE[@]}" \
      --label caui.run="$run" --label caui.started="$(date +%s)" "$IMAGE" sleep 7200 >/dev/null
    echo "$IMAGE" ;;
  exec)
    t="${1:-}"; cmd="${2:-}"; [[ "$t" =~ ^[0-9]{1,4}$ ]] && (( t >= 1 && t <= 900 )) || die "timeout 1-900"
    [ -n "$cmd" ] || die "empty command"
    "$ENGINE" exec -u dev -w /work "$c" timeout --kill-after=10 "$t" bash -lc "$cmd" 2>&1 ;;
  put)
    p="${1:-}"; path_ok "$p"
    head -c 5000000 | "$ENGINE" exec -i -u dev "$c" sh -c 'mkdir -p "$(dirname "$1")" && cat > "$1"' _ "$p" ;;
  get)
    p="${1:-}"; path_ok "$p"
    "$ENGINE" exec -u dev "$c" sh -c 'head -c 2000000 -- "$1"' _ "$p" ;;
  tarwork)
    "$ENGINE" exec -u dev "$c" tar czf - -C /work --exclude=node_modules --exclude=.venv --exclude=.git . 2>/dev/null | head -c 20000000 ;;
  rm)
    "$ENGINE" rm -f "$c" >/dev/null 2>&1 || true ;;
  docswalk)
    urls="$(grep -E '^https?://[^[:space:]]+$' | head -8 || true)"; [ -n "$urls" ] || die "no urls"
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT; chmod 777 "$tmp"
    user=(); [ "$ENGINE" = docker ] && user=(--user "$(id -u):$(id -g)")
    "$ENGINE" run --rm "${user[@]}" --network "$NET" --memory 2g --cpus 2 "${SAFE[@]}" \
      -e URLS="$urls" -v "$tmp:/video" "$RECORDER" >&2
    cat "$tmp/docs-walk.webm" ;;
  build)
    [ -f "$HARNESS/sandbox/Containerfile" ] || die "no harness at $HARNESS"
    tag="$(date -u +%Y%m%d)"; mkdir -p "$CONF"
    "$ENGINE" build -q -f "$HARNESS/sandbox/Containerfile" -t "caui-sandbox:$tag" "$HARNESS" >/dev/null
    "$ENGINE" build -q -f "$HARNESS/sandbox/Containerfile.recorder" -t "caui-recorder:$tag" "$HARNESS" >/dev/null
    echo "caui-sandbox:$tag" >"$CONF/image"; echo "caui-recorder:$tag" >"$CONF/recorder"
    echo "caui-sandbox:$tag caui-recorder:$tag" ;;
  reap)
    now="$(date +%s)"
    "$ENGINE" ps -a --filter label=caui.run --format '{{.Names}} {{.Labels}}' | while read -r name labels; do
      s="$(grep -o 'caui.started:[0-9]*\|caui.started=[0-9]*' <<<"$labels" | grep -o '[0-9]*$' || echo 0)"
      (( now - s > 7200 )) && "$ENGINE" rm -f "$name" >/dev/null && echo "reaped $name"
    done; true ;;
  *) die "usage: caui-box start|exec|put|get|tarwork|rm|docswalk <run> … | build | reap" ;;
esac
